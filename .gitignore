# Dependencies and package manager caches
/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/.npm/

# Next.js, builds and generated Prisma client
/.next/
/out/
/build/
/dist/
/generated/
next-env.d.ts
*.tsbuildinfo

# Generated standalone previews, ZIP files and screenshots
/exports/

# Uploads: version directory placeholders only
/uploads/**
!/uploads/**/
!/uploads/**/.gitkeep
/.private/

# Environment secrets: keep only the documented template
.env*
!.env.example
*.pem
*.key
*.p12
*.pfx
/.aws/
/.ssh/

# Local databases, backups and dumps (SQL migrations stay versioned)
*.db
*.db-journal
*.sqlite
*.sqlite3
*.dump
*.backup
/backups/
/dumps/

# Test reports and tool/browser caches
/coverage/
/test-results/
/playwright-report/
/blob-report/
/.preview-browser/
/.cache/
/.turbo/
.pytest_cache/
__pycache__/
*.py[cod]
.eslintcache
.prettiercache

# Local logs and temporary files
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
/tmp/
/temp/

# Local hosting, IDE and operating system files
/.vercel/
/.idea/
/.vs/
.DS_Store
Thumbs.db
Desktop.ini
