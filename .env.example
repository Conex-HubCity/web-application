# Copy to .env and replace the placeholders with your local PostgreSQL credentials.
# Server-only variable: never add the NEXT_PUBLIC_ prefix.
# URL-encode special characters in the password.
DATABASE_URL="postgresql://conex:CHANGE_ME@localhost:5432/conex?schema=public"

# Local-only upload simulation. Always ignored when NODE_ENV=production.
CERTIFICATION_TEST_MODE="true"

# Optional dedicated test database. Tests create and remove their own temporary schema.
# TEST_DATABASE_URL="postgresql://conex:CHANGE_ME@localhost:5432/conex_test?schema=public"

# Optional demo dataset; never falls back to DATABASE_URL. Use a migrated database.
# SEED_DATABASE_URL="postgresql://conex:CHANGE_ME@localhost:5432/conex_demo?schema=public"
# Explicit opt-in for a production-named database or NODE_ENV=production used for testing.
# Stripe live mode is always refused, including with this opt-in.
# SEED_ALLOW_PRODUCTION="false"
# SEED_PASSWORD="Connex-Demo-2026!"

# Required to send OTP emails. Port 465: secure=true; port 587: secure=false, require TLS.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_REQUIRE_TLS="true"
SMTP_USER=""
SMTP_PASSWORD=""
# Single email address or display name, e.g. "Connex <noreply@example.com>".
SMTP_FROM=""
# Generate a private random secret of at least 32 characters; never commit the real value.
EMAIL_OTP_SECRET="CHANGE_ME_GENERATE_A_RANDOM_SECRET"

# Stripe Checkout: one-time 30 USD contribution. Private server-only values.
STRIPE_MODE="test"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Canonical origin for Stripe returns and password/invitation links; use HTTPS in production.
APP_URL="http://localhost:3000"

# Public founder signup, read at runtime. Restart the server after changing it; no rebuild needed.
# Existing accounts and private invitations remain available.
FOUNDER_REGISTRATION_ENABLED="false"
