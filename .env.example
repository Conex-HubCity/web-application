# Copy to .env and replace the placeholders with your local PostgreSQL credentials.
# Server-only variable: never add the NEXT_PUBLIC_ prefix.
# URL-encode special characters in the password.
DATABASE_URL="postgresql://conex:CHANGE_ME@localhost:5432/conex?schema=public"

# Local-only upload simulation. Always ignored when NODE_ENV=production.
CERTIFICATION_TEST_MODE="true"

# Optional dedicated test database. Tests create and remove their own temporary schema.
# TEST_DATABASE_URL="postgresql://conex:CHANGE_ME@localhost:5432/conex_test?schema=public"

# Deployable mentor preview: signup, documents and review only; approved mentors see a holding page.
# Set false to restore the complete app. Set identically at build and runtime, then rebuild/restart.
MENTOR_PREVIEW_MODE="true"

# Required to send OTP emails. Port 465: secure=true; port 587: secure=false, require TLS.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_REQUIRE_TLS="true"
SMTP_USER=""
SMTP_PASSWORD=""
# Single email address or display name, e.g. "Connex <noreply@example.com>".
SMTP_FROM=""
# Generate a private random secret of at least 32 characters; never commit the real value.
EMAIL_OTP_SECRET="CHANGE_ME_GENERATE_A_RANDOM_SECRET"
